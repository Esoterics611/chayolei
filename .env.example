# ── Rank Attestation Signer (SECRET) ───────────────────────────
# EIP-712 signing key used by /api/governance/attestation to authenticate
# voter ranks on-chain. MUST match ChayoleiGovernance.attestationSigner().
# Generate a fresh key per environment; rotate via setAttestationSigner()
# if ever exposed. Production: use a KMS/HSM, not plain env.
ATTESTATION_SIGNER_PRIVATE_KEY=0x...

# ── Donation Rail (D1) ─────────────────────────────────────────
# Wallet that receives TMIM minted for incoming support donations.
# Leave blank to skip on-chain minting (Firestore record still written).
DONATION_TRACKING_WALLET=
