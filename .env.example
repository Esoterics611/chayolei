# ── Firebase Client SDK ─────────────────────────────────────────
# Get these from: Firebase Console → Your project → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── New UI backend ──────────────────────────────────────────────
# firestore: the live app (sign in with a wallet; teams in Firestore).
# Unset: the demo (sample teams kept in the browser).
VITE_TEAM_BACKEND=
# 1: the browser talks to the local Firebase emulators (Auth 9099, Firestore
# 8080). For local development and browser tests only.
VITE_FIREBASE_EMULATORS=

# ── Firebase Admin SDK ──────────────────────────────────────────
# Local development only. On Cloud Run the runtime service account is used
# instead (see docs/DEPLOY.md); leave the email and key unset there.
# Get these from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Base Sepolia ────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=

# ── Contract addresses (Base Sepolia) ──────────────────────────
VITE_TMIM_TOKEN_ADDRESS=
VITE_CHAYOLEI_REGISTRY_ADDRESS=
VITE_MASIMA_REWARDS_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_GOVERNANCE_ADDRESS=
VITE_GOVERNANCE_TREASURY_ADDRESS=
VITE_MASIMA_REWARDS_V2_ADDRESS=
ATTESTATION_SIGNER_PRIVATE_KEY=

# ── Team contracts (the live app records on-chain) ──────────────
# Set all four to record live teams' settled actions on their Team contract
# (docs/TEAM_BACKEND.md §6). Without them, live teams stay off-chain.
TEAM_FACTORY_ADDRESS=
TEAM_FORWARDER_ADDRESS=
# The platform's relayer: submits members' signed requests and pays the fee;
# also the factory's anchoring service (TEAM_ANCHORER at deploy).
TEAM_RELAYER_PRIVATE_KEY=
# RPC for the team contracts (defaults to BASE_SEPOLIA_RPC_URL)
TEAM_CHAIN_RPC_URL=
# Block explorer for links (defaults to Basescan on Base Sepolia)
TEAM_EXPLORER_URL=
# Where the reconciler starts reading teams' contracts the first time
# (deploy-teams.ts prints it), and how long it leaves the app to record its
# own actions before reading a block (docs/TEAM_BACKEND.md §6b).
TEAM_START_BLOCK=
TEAM_RECONCILE_DELAY_SECONDS=120
# Daily limits on what costs the platform (docs/TEAM_BACKEND.md §3)
TEAM_STARTS_PER_ACCOUNT_DAY=3
TEAM_STARTS_PLATFORM_DAY=200
TEAM_INVITES_PER_TEAM_DAY=20
TEAM_JOINS_PER_TEAM_DAY=50

# ── AI planner (docs/TEAM_BACKEND.md §6a) ──────────────────────
# Claude API key for the planner's suggestions. Without it the planner says it
# isn't set up; everything else works. A secret: Secret Manager in production.
ANTHROPIC_API_KEY=
# Model for the planner (defaults to claude-opus-5-5)
TEAM_AI_MODEL=
# Deploy only: 1 makes scripts/deploy.sh pass the anthropic-api-key secret
# from Secret Manager as ANTHROPIC_API_KEY (docs/DEPLOY.md)
TEAM_AI=

# ── Governance listener ─────────────────────────────────────────
# Block ChayoleiGovernance was deployed at. On first start the listener reads
# every governance event from here; later starts resume from its checkpoint.
GOVERNANCE_START_BLOCK=

# ── Donation Rail ───────────────────────────────────────────────
DONATION_TRACKING_WALLET=
