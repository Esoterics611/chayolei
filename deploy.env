# The live project's PUBLIC values, committed on purpose: the VITE_* ones are
# baked into every visitor's browser anyway. No secret ever goes here: keys
# live in Secret Manager (docs/DEPLOY.md). Read by scripts/deploy.sh after .env
# and by .github/workflows/deploy.yml.
#
# Filled from the Firebase console (Project settings → Your apps → Web app →
# SDK setup and configuration → Config) and from scripts/gcp-bootstrap.sh's output.

# spark: the free version (no server, no billing); server: Cloud Run (needs the Blaze plan).
DEPLOY_MODE=spark
FIREBASE_PROJECT_ID=sefer-forge-485e4
VITE_FIREBASE_PROJECT_ID=sefer-forge-485e4
VITE_FIREBASE_API_KEY=AIzaSyBWqojlpdFeYFyewlWDrHsucw10XnWs6V8
VITE_FIREBASE_AUTH_DOMAIN=sefer-forge-485e4.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=sefer-forge-485e4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1048865357848
VITE_FIREBASE_APP_ID=
VITE_TEAM_BACKEND=firestore

# GitHub Actions signs in to Google with no stored key (Workload Identity Federation).
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/1048865357848/locations/global/workloadIdentityPools/github/providers/chayolei
GCP_DEPLOYER_SERVICE_ACCOUNT=deployer@sefer-forge-485e4.iam.gserviceaccount.com

# Where the app is served; links in emails point here.
PUBLIC_ORIGIN=https://sefer-forge-485e4.web.app
# 1 once the Resend key and the unsubscribe secret are in Secret Manager.
MAIL=
MAIL_FROM=
